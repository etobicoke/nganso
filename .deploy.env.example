# Copy this file to .deploy.env and fill it in. .deploy.env is gitignored,
# so your host and key path never get committed.

# Hostname or IP of your Linode
DEPLOY_HOST=

# SSH user (a non-root deploy user is recommended over root)
DEPLOY_USER=root

# Absolute web root nginx serves (must match deploy/nginx/nganso.conf)
DEPLOY_PATH=/var/www/nganso

# SSH port (usually 22)
DEPLOY_PORT=22

# Optional: path to the SSH private key for this host.
# If your LINODE_KEY is an SSH key, point this at it, e.g. SSH_KEY=~/.ssh/linode
SSH_KEY=

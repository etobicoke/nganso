# Copy this file to .deploy.env and fill it in. .deploy.env is gitignored,
# so your host and key path never get committed.

# Hostname or IP of the Linode (shared with wemba, olochat, santeclub)
DEPLOY_HOST=

# SSH user
DEPLOY_USER=deploy

# Folder the sites-nganso-1 Caddy container serves (bind-mounted at /srv)
DEPLOY_PATH=/opt/sites/nganso/dist

# SSH port (usually 22)
DEPLOY_PORT=22

# SSH private key for the deploy user (the same key the wemba project uses)
SSH_KEY=

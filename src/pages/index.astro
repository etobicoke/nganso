---
// Homepage — Gustave Nganso.
// Self-contained page: it owns its <head> and a global <style> block, so it does
// NOT use Layout.astro (that layout carries the old site's video/coming-soon
// styles). Google Analytics (gtag) is inlined below to preserve the site's
// existing tracking (G-1KVEFPH9TZ). The old homepage now lives at /coming-soon.
import OlotalkSearch from "../components/OlotalkSearch.astro";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Analytics (gtag) — inlined verbatim so Astro leaves it untouched -->
  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-1KVEFPH9TZ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1KVEFPH9TZ');
  </script>

  <!-- Marker class so reveal styles apply only when JS is on (prevents a flash of hidden content) -->
  <script is:inline>document.documentElement.classList.add('js');</script>

  <title>Gustave Nganso · Generative AI in your company. I'm on it.</title>
  <meta name="description" content="Gustave Nganso — Toronto-based generative AI (GenAI) consultant. Nearly 20 years shipping production systems; I help enterprises put generative AI to work — RAG, LLM assistants, and automation that actually runs." />

  <!-- Fonts: Instrument Sans (display + body), IBM Plex Mono (metadata). No external JS. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style is:global>
    /* ---------- Design tokens ---------- */
    :root {
      --bg: #ffffff;
      --ink: #101418;
      --gray: #5b6470;
      --hairline: #e6e8eb;
      --accent: #2547f4;

      --sans: "Instrument Sans", system-ui, -apple-system, sans-serif;
      --mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;

      --maxw: 880px;
      --pad: 24px;
    }

    /* ---------- Reset ---------- */
    *, *::before, *::after { box-sizing: border-box; }
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 88px; /* offset for the sticky nav */
      -webkit-text-size-adjust: 100%;
    }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 17px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    a { color: inherit; }
    img { max-width: 100%; display: block; }

    /* ---------- Shared bits ---------- */
    .wrap {
      width: 100%;
      max-width: var(--maxw);
      margin: 0 auto;
      padding-left: var(--pad);
      padding-right: var(--pad);
    }

    /* Mono metadata: labels, dates, tags, links */
    .mono {
      font-family: var(--mono);
      font-size: 12.5px;
      font-weight: 400;
      letter-spacing: 0.02em;
    }

    .section {
      padding-top: 84px;
      padding-bottom: 84px;
      border-top: 1px solid var(--hairline);
    }

    .section-label {
      font-family: var(--mono);
      font-size: 12.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--gray);
      margin: 0 0 40px;
    }

    .accent { color: var(--accent); }

    /* ---------- Focus visibility ---------- */
    a:focus-visible,
    summary:focus-visible,
    button:focus-visible,
    .btn:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: 2px;
    }

    /* ---------- Sticky nav ---------- */
    .nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255, 255, 255, 0.72);
      -webkit-backdrop-filter: saturate(180%) blur(14px);
      backdrop-filter: saturate(180%) blur(14px);
      border-bottom: 1px solid var(--hairline);
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      height: 64px;
    }
    .nav-name {
      font-weight: 600;
      letter-spacing: -0.02em;
      font-size: 16px;
      text-decoration: none;
      white-space: nowrap;
    }
    .nav-links {
      display: flex;
      gap: 22px;
      align-items: center;
    }
    .nav-links a {
      font-family: var(--mono);
      font-size: 12.5px;
      letter-spacing: 0.02em;
      color: var(--gray);
      text-decoration: none;
      transition: color 0.18s ease;
    }
    .nav-links a:hover { color: var(--accent); }

    /* ---------- Hero ---------- */
    .hero { padding-top: 92px; padding-bottom: 92px; }

    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--gray);
      margin: 0 0 34px;
    }
    .dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--accent);
      flex: none;
      position: relative;
    }
    .dot::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--accent);
      animation: pulse 2.2s ease-out infinite;
    }
    @keyframes pulse {
      0%   { transform: scale(1);   opacity: 0.6; }
      70%  { transform: scale(2.6); opacity: 0; }
      100% { transform: scale(2.6); opacity: 0; }
    }

    .headline {
      margin: 0;
      font-weight: 700;
      font-size: clamp(42px, 8vw, 84px);
      line-height: 1.02;
      letter-spacing: -0.035em;
    }
    .headline .line2 { display: block; }

    .lede {
      margin: 34px 0 0;
      max-width: 620px;
      font-size: clamp(18px, 2.2vw, 21px);
      line-height: 1.55;
      color: var(--gray);
    }
    .lede strong { color: var(--ink); font-weight: 600; }

    .hero-links {
      display: flex;
      flex-wrap: wrap;
      gap: 26px;
      margin-top: 40px;
    }
    .hero-links a {
      font-family: var(--mono);
      font-size: 12.5px;
      letter-spacing: 0.02em;
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid var(--hairline);
      padding-bottom: 3px;
      transition: color 0.18s ease, border-color 0.18s ease;
    }
    .hero-links a:hover { color: var(--accent); border-color: var(--accent); }
    .hero-links a::before { content: "↗ "; color: var(--gray); }

    /* ---------- Services (1px-gap grid via background trick) ---------- */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--hairline);
      border: 1px solid var(--hairline);
    }
    .service {
      background: var(--bg);
      padding: 32px 28px 36px;
    }
    .service-num {
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--accent);
      letter-spacing: 0.04em;
      margin: 0 0 20px;
    }
    .service h3 {
      margin: 0 0 12px;
      font-size: 21px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .service p {
      margin: 0;
      color: var(--gray);
      font-size: 15.5px;
      line-height: 1.55;
    }

    /* Embedded framing + engagement models */
    .services-intro,
    .exp-intro {
      margin: -16px 0 40px;
      max-width: 640px;
      font-size: clamp(17px, 2vw, 19px);
      line-height: 1.55;
      color: var(--gray);
    }
    .services-intro strong { color: var(--ink); font-weight: 600; }

    .engagements {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      margin-top: 40px;
      padding-top: 36px;
      border-top: 1px solid var(--hairline);
    }
    .engagement-kicker {
      margin: 0 0 10px;
      color: var(--accent);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .engagement p {
      margin: 0;
      color: var(--gray);
      font-size: 15.5px;
      line-height: 1.55;
    }
    .engagement p strong { color: var(--ink); font-weight: 600; }

    /* ---------- Trust strip (hero) ---------- */
    .trust { margin-top: 52px; }
    .trust-label {
      color: var(--gray);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin: 0 0 14px;
    }
    .trust-names {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px 26px;
      margin: 0;
      padding: 0;
    }
    .trust-names li {
      font-size: clamp(16px, 2.2vw, 19px);
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--ink);
    }

    /* ---------- Security & governance ---------- */
    .gov-intro {
      margin: -16px 0 44px;
      max-width: 640px;
      font-size: clamp(17px, 2vw, 19px);
      line-height: 1.55;
      color: var(--gray);
    }
    .gov-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 34px 48px;
    }
    .gov-item h3 {
      margin: 0 0 8px;
      font-size: 17px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .gov-mark { color: var(--accent); margin-right: 6px; }
    .gov-item p {
      margin: 0;
      color: var(--gray);
      font-size: 15.5px;
      line-height: 1.55;
    }

    /* ---------- Selected work (details/summary) ---------- */
    .work-list {
      border-top: 1px solid var(--hairline);
    }
    .work-item {
      border-bottom: 1px solid var(--hairline);
    }
    .work-summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 20px;
      padding: 26px 0;
      transform: translateX(4px);
      transition: transform 0.2s ease;
    }
    .work-summary::-webkit-details-marker { display: none; }
    .work-summary:hover { transform: translateX(12px); }
    .work-name {
      font-size: clamp(22px, 3.4vw, 30px);
      font-weight: 600;
      letter-spacing: -0.02em;
      transition: color 0.18s ease;
    }
    details[open] > .work-summary .work-name { color: var(--accent); }
    .work-meta {
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--gray);
      white-space: nowrap;
      flex: none;
    }
    .work-toggle { color: var(--accent); margin-left: 6px; }
    details[open] .work-toggle .plus { display: none; }
    details:not([open]) .work-toggle .minus { display: none; }

    .work-body {
      padding: 4px 0 30px;
      max-width: 640px;
    }
    .tags {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 20px;
      padding: 0;
    }
    .tags li {
      font-family: var(--mono);
      font-size: 11.5px;
      letter-spacing: 0.02em;
      color: var(--gray);
      border: 1px solid var(--hairline);
      border-radius: 999px;
      padding: 4px 12px;
    }
    .work-body p {
      margin: 0 0 18px;
      color: var(--gray);
      font-size: 16px;
      line-height: 1.6;
    }
    .work-body p strong { color: var(--ink); font-weight: 600; }
    .case-link {
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.18s ease;
    }
    .case-link:hover { border-color: var(--accent); }
    .case-link::after { content: " →"; }

    /* ---------- Experience ---------- */
    .exp-row {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 24px;
      padding: 24px 0;
      border-bottom: 1px solid var(--hairline);
    }
    .exp-row:first-of-type { border-top: 1px solid var(--hairline); }
    .exp-date {
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--gray);
      padding-top: 4px;
    }
    .exp-role {
      margin: 0 0 4px;
      font-size: 18px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .exp-company { color: var(--gray); }
    .exp-detail {
      margin: 8px 0 0;
      color: var(--gray);
      font-size: 15.5px;
      line-height: 1.55;
    }

    .btn {
      display: inline-block;
      margin-top: 36px;
      font-family: var(--mono);
      font-size: 12.5px;
      letter-spacing: 0.02em;
      color: var(--ink);
      text-decoration: none;
      border: 1px solid var(--ink);
      border-radius: 999px;
      padding: 11px 22px;
      transition: color 0.18s ease, border-color 0.18s ease;
    }
    .btn:hover { color: var(--accent); border-color: var(--accent); }

    /* ---------- Writing ---------- */
    .post {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 20px;
      padding: 22px 0;
      border-bottom: 1px solid var(--hairline);
      text-decoration: none;
      transform: translateX(0);
      transition: transform 0.2s ease;
    }
    .post:first-of-type { border-top: 1px solid var(--hairline); }
    .post:hover { transform: translateX(10px); }
    .post-title {
      font-size: clamp(18px, 2.6vw, 22px);
      font-weight: 600;
      letter-spacing: -0.015em;
      transition: color 0.18s ease;
    }
    .post:hover .post-title { color: var(--accent); }
    .post-date {
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--gray);
      white-space: nowrap;
      flex: none;
    }
    .writing-note {
      margin: 28px 0 0;
      font-style: italic;
      color: var(--gray);
      font-size: 15.5px;
    }

    /* ---------- Footer ---------- */
    .footer { border-top: 1px solid var(--hairline); }
    .cta {
      margin: 0;
      font-weight: 700;
      font-size: clamp(30px, 5.2vw, 52px);
      line-height: 1.06;
      letter-spacing: -0.03em;
      max-width: 720px;
    }
    .cta-email {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 5px;
      text-decoration-thickness: 2px;
    }
    .fine-print {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px 26px;
      margin-top: 56px;
      font-family: var(--mono);
      font-size: 12.5px;
      color: var(--gray);
    }
    .fine-print a {
      color: var(--gray);
      text-decoration: none;
      transition: color 0.18s ease;
    }
    .fine-print a:hover { color: var(--accent); }
    .fine-print .links { display: flex; gap: 20px; }

    /* ---------- Contact form ---------- */
    .contact-form {
      margin: 44px 0 8px;
      max-width: 560px;
      display: grid;
      gap: 20px;
    }
    .field { display: grid; gap: 8px; }
    .field label {
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--gray);
    }
    .field input,
    .field textarea {
      font-family: var(--sans);
      font-size: 16px;
      color: var(--ink);
      background: var(--bg);
      border: 1px solid var(--hairline);
      border-radius: 8px;
      padding: 12px 14px;
      width: 100%;
    }
    .field textarea { min-height: 128px; resize: vertical; }
    .field input:focus,
    .field textarea:focus {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
      border-color: var(--accent);
    }
    .btn-submit {
      justify-self: start;
      font-family: var(--mono);
      font-size: 12.5px;
      letter-spacing: 0.02em;
      color: #fff;
      background: var(--accent);
      border: 1px solid var(--accent);
      border-radius: 999px;
      padding: 12px 24px;
      cursor: pointer;
      transition: opacity 0.18s ease;
    }
    .btn-submit:hover { opacity: 0.88; }
    /* Honeypot: pushed off-screen; bots fill it and get rejected by Web3Forms */
    .hp {
      position: absolute !important;
      left: -9999px !important;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }
    .form-status {
      margin: 2px 0 0;
      font-family: var(--mono);
      font-size: 12.5px;
      min-height: 1.2em;
      color: var(--gray);
    }
    .form-status.is-ok { color: var(--accent); }
    .form-status.is-err { color: #c1121f; }

    /* ---------- Motion layer (scroll reveals + micro-interactions) ---------- */
    /* Reveal targets start hidden ONLY when JS is on and motion is allowed, so
       no-JS and reduced-motion visitors always see content immediately. */
    @media (prefers-reduced-motion: no-preference) {
      html.js .hero > *,
      html.js #services .section-label,
      html.js #services .services-intro,
      html.js .service,
      html.js .engagement,
      html.js #governance .section-label,
      html.js .gov-intro,
      html.js .gov-item,
      html.js #work .section-label,
      html.js .work-item,
      html.js #experience .section-label,
      html.js .exp-intro,
      html.js .exp-row,
      html.js #experience .btn,
      html.js #writing .section-label,
      html.js .post,
      html.js .writing-note,
      html.js #contact .cta,
      html.js .contact-form,
      html.js #contact .fine-print {
        opacity: 0;
        transform: translateY(22px) scale(0.97);
        filter: blur(6px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }
      html.js .is-visible {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
      }

      /* Hero: cascade in on load */
      html.js .hero .headline   { transition-delay: 0.12s; }
      html.js .hero .lede       { transition-delay: 0.24s; }
      html.js .hero .hero-links { transition-delay: 0.36s; }
      html.js .hero .trust      { transition-delay: 0.48s; }

      /* Stagger for items that enter together */
      html.js .services-grid .service:nth-child(2)  { transition-delay: 0.12s; }
      html.js .services-grid .service:nth-child(3)  { transition-delay: 0.24s; }
      html.js .engagements .engagement:nth-child(2) { transition-delay: 0.12s; }
      html.js .gov-item:nth-child(2)                { transition-delay: 0.08s; }
      html.js .gov-item:nth-child(3)                { transition-delay: 0.14s; }
      html.js .gov-item:nth-child(4)                { transition-delay: 0.20s; }
      html.js .gov-item:nth-child(5)                { transition-delay: 0.26s; }
      html.js .gov-item:nth-child(6)                { transition-delay: 0.32s; }
      html.js .work-item:nth-of-type(2)             { transition-delay: 0.10s; }
      html.js .work-item:nth-of-type(3)             { transition-delay: 0.20s; }
      html.js #writing .post:nth-of-type(2)         { transition-delay: 0.10s; }
    }

    /* Work row: ease the body in when a project is opened */
    details[open] .work-body {
      animation: workReveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes workReveal {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: none; }
    }

    /* Nav links: an underline that draws in on hover/focus */
    .nav-links a { position: relative; }
    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -4px;
      height: 1px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.22s ease;
    }
    .nav-links a:hover::after,
    .nav-links a:focus-visible::after { transform: scaleX(1); }

    /* ---------- Responsive ---------- */
    @media (max-width: 720px) {
      .services-grid { grid-template-columns: 1fr; }
      .gov-grid { grid-template-columns: 1fr; gap: 28px; }
      .engagements { grid-template-columns: 1fr; gap: 28px; }
      .exp-row { grid-template-columns: 1fr; gap: 6px; }
      .exp-date { padding-top: 0; }
      .nav-links { gap: 14px; }
      .section { padding-top: 64px; padding-bottom: 64px; }
      .hero { padding-top: 68px; padding-bottom: 68px; }
    }
    @media (max-width: 560px) {
      /* Keep the nav usable: drop the middle links, keep Contact reachable */
      .nav-links a.nav-hide { display: none; }
    }

    /* ---------- Reduced motion ---------- */
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
      }
      .dot::after { display: none; }
    }
  </style>
</head>
<body>

  <!-- ================= NAV ================= -->
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="nav-name" href="#top">Gustave Nganso</a>
      <nav class="nav-links" aria-label="Primary">
        <a class="nav-hide" href="#services">Services</a>
        <a class="nav-hide" href="#governance">Governance</a>
        <a class="nav-hide" href="#work">Work</a>
        <a class="nav-hide" href="#experience">Experience</a>
        <a class="nav-hide" href="#writing">Writing</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top">

    <!-- ================= HERO ================= -->
    <section class="hero wrap" aria-label="Introduction">
      <p class="kicker mono">
        <span class="dot" aria-hidden="true"></span>
        Toronto, Canada · taking on new clients
      </p>

      <h1 class="headline">
        AI in your company.
        <span class="line2 accent">I'm on it.</span>
      </h1>

      <p class="lede">
        A lot of companies are stuck at <strong>&ldquo;we should be using
        generative AI.&rdquo;</strong> Getting to something real, running in
        production, is the hard part. That&rsquo;s what I do.
      </p>

      <nav class="hero-links" aria-label="Elsewhere">
        <!-- Profile links -->

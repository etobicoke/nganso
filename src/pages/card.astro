---
// /card — digital business card for conferences.
//
// One page, two modes, chosen before first paint by the inline script below:
//   • Presenter (Gustave opens it from his phone's home screen, no query
//     string): a big QR code with a Website | LinkedIn | Resume switch, and
//     the screen is kept awake while it's showing.
//   • Visitor (someone scanned the website QR, which adds ?utm_source=qr):
//     the QR is hidden and they get Save contact, the site, LinkedIn and
//     the resume.
// Without JS both QR codes stay hidden except the website one, and the
// buttons are always shown.
//
// QR codes are generated at build time as inline SVG — no third-party QR
// service, no runtime library. Changing a URL below means a rebuild.
// The offline PNGs in public/assets/images/card/ encode the same URLs; see
// docs/site-notes.md for how to regenerate them if the URLs change.
import QRCode from "qrcode";

const SITE = "https://nganso.com";
const CARD_URL = `${SITE}/card/?utm_source=qr&utm_medium=card`;
const LINKEDIN = "https://www.linkedin.com/in/gnganso/";
const RESUME = `${SITE}/resume.pdf`;

const qrOptions = {
  type: "svg",
  margin: 4, // the quiet zone scanners need, as white modules inside the SVG
  errorCorrectionLevel: "M",
  color: { dark: "#101418", light: "#ffffff" },
};
const qrSite = await QRCode.toString(CARD_URL, qrOptions);
const qrLinkedIn = await QRCode.toString(LINKEDIN, qrOptions);
const qrResume = await QRCode.toString(RESUME, qrOptions);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="robots" content="noindex" />

  <!-- Google Analytics (gtag) — same property as the rest of the site -->
  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-1KVEFPH9TZ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1KVEFPH9TZ');
  </script>

  <!-- Pick the mode before first paint so the QR never flashes for visitors -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      root.classList.add('js');
      if (new URLSearchParams(location.search).get('utm_source') === 'qr') {
        root.classList.add('is-visitor');
      }
    })();
  </script>

  <title>Gustave Nganso · Card</title>
  <meta name="description" content="Gustave Nganso — principal AI developer and founder of Olochat AI Inc. Save my contact or find me on LinkedIn." />

  <!-- Add to Home Screen: opens full-screen like an app, with its own icon -->
  <link rel="manifest" href="/card.webmanifest" />
  <link rel="apple-touch-icon" href="/assets/images/card/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Gustave" />
  <meta name="theme-color" content="#ffffff" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style is:global>
    /* ---------- Design tokens (identical to the other pages) ---------- */
    :root {
      --bg: #ffffff;
      --ink: #101418;
      --gray: #4a525c;
      --hairline: #e6e8eb;
      --accent: #2547f4;

      --sans: "Instrument Sans", system-ui, -apple-system, sans-serif;
      --mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;

      /* Type scale: small sizes shared across the site */
      --fs-meta: 14px;   /* mono labels, dates, links, nav, buttons */
      --fs-small: 13px;  /* tags, form labels, captions */
      --fs-text: 17px;   /* reading text in cards and lists */
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-size: var(--fs-text);
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }
    [hidden] { display: none !important; }
    .mono { font-family: var(--mono); font-size: var(--fs-meta); letter-spacing: 0.02em; }

    .card {
      max-width: 440px;
      min-height: 100svh;
      margin: 0 auto;
      padding: max(32px, env(safe-area-inset-top)) 20px max(32px, env(safe-area-inset-bottom));
      display: flex;
      flex-direction: column;
    }

    .kicker {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0 0 14px;
      color: var(--gray);
    }
    .dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--accent);
      flex: none;
    }
    .kicker-visitor { display: none; }
    html.is-visitor .kicker-default { display: none; }
    html.is-visitor .kicker-visitor { display: inline; }

    .name {
      margin: 0 0 12px;
      font-size: clamp(38px, 11vw, 48px);
      font-weight: 700;
      line-height: 1.02;
      letter-spacing: -0.03em;
    }
    .role {
      margin: 0 0 26px;
      font-size: 19px;
      line-height: 1.45;
      color: var(--gray);
    }
    .role strong { color: var(--ink); font-weight: 600; }

    /* ---------- Presenter: QR codes ---------- */
    .present { margin: 0 0 28px; text-align: center; }
    html.is-visitor .present { display: none; }

    .switch {
      display: none; /* needs JS */
      gap: 4px;
      padding: 4px;
      margin: 0 0 16px;
      border: 1px solid var(--hairline);
      border-radius: 999px;
    }
    html.js .switch { display: inline-flex; }
    .switch button {
      font: inherit;
      font-family: var(--mono);
      font-size: var(--fs-meta);
      letter-spacing: 0.02em;
      padding: 9px 18px;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--gray);
      cursor: pointer;
    }
    .switch button[aria-selected="true"] { background: var(--ink); color: #fff; }
    /* Three tabs overflow a 320px screen at full padding */
    @media (max-width: 359px) { .switch button { padding: 9px 12px; } }

    .qr {
      border: 1px solid var(--hairline);
      border-radius: 18px;
      overflow: hidden;
      background: #fff;
    }
    .qr svg { display: block; width: 100%; height: auto; }
    .qr-caption { margin: 12px 0 0; color: var(--gray); }

    /* ---------- Actions ---------- */
    .actions { display: grid; gap: 10px; }
    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 54px;
      padding: 0 20px;
      border: 1px solid var(--ink);
      border-radius: 999px;
      color: var(--ink);
      text-decoration: none;
      font-family: var(--mono);
      font-size: var(--fs-meta);
      letter-spacing: 0.02em;
    }
    .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .actions .company {
      margin-top: 8px;
      text-align: center;
      color: var(--gray);
    }
    .actions .company a { color: inherit; }

    .offline {
      margin: 28px 0 0;
      text-align: center;
      color: var(--gray);
      font-size: var(--fs-small);
    }
    .offline a { color: inherit; }
    html.is-visitor .offline { display: none; }
  </style>
</head>
<body>
  <main class="card">
    <p class="kicker mono">
      <span class="dot" aria-hidden="true"></span>
      <span class="kicker-default">Toronto · Founder, Olochat AI Inc.</span>
      <span class="kicker-visitor">Nice to meet you</span>
    </p>
    <h1 class="name">Gustave Nganso</h1>
    <p class="role">
      <strong>Principal AI developer.</strong> I embed in your team and ship
      AI that runs in production.
    </p>

    <section class="present" aria-label="QR codes to scan">
      <div class="switch" role="tablist" aria-label="Which QR code">
        <button type="button" role="tab" aria-selected="true" data-qr="site">Website</button>
        <button type="button" role="tab" aria-selected="false" data-qr="linkedin">LinkedIn</button>
        <button type="button" role="tab" aria-selected="false" data-qr="resume">Resume</button>
      </div>
      <div class="qr" data-panel="site" role="img" aria-label="QR code that opens Gustave Nganso's card on nganso.com" set:html={qrSite}></div>
      <div class="qr" data-panel="linkedin" role="img" aria-label="QR code that opens Gustave Nganso's LinkedIn profile" set:html={qrLinkedIn} hidden></div>
      <div class="qr" data-panel="resume" role="img" aria-label="QR code that opens Gustave Nganso's resume (PDF)" set:html={qrResume} hidden></div>
      <p class="qr-caption mono" data-caption="site">Scan to save my contact</p>
      <p class="qr-caption mono" data-caption="linkedin" hidden>Scan to connect on LinkedIn</p>
      <p class="qr-caption mono" data-caption="resume" hidden>Scan to open my resume</p>
    </section>

    <nav class="actions" aria-label="Contact">
      <a class="btn btn-primary" href="/gustave-nganso.vcf" data-save-contact>Save contact</a>
      <a class="btn" href="/">Visit nganso.com</a>
      <a class="btn" href={LINKEDIN}>Connect on LinkedIn</a>
      <a class="btn" href="/resume.pdf" data-resume>Download resume (PDF)</a>
      <p class="company mono"><a href="https://olochat.ca">olochat.ca</a></p>
    </nav>

    <p class="offline mono">
      No signal? Save these to your photos:
      <a href="/assets/images/card/qr-lockscreen.png">website QR</a> ·
      <a href="/assets/images/card/qr-linkedin.png">LinkedIn QR</a> ·
      <a href="/assets/images/card/qr-resume.png">resume QR</a>
    </p>
  </main>

  <script is:inline>
    (function () {
      var visitor = document.documentElement.classList.contains('is-visitor');

      // Website | LinkedIn switch
      var tabs = document.querySelectorAll('[data-qr]');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var which = tab.getAttribute('data-qr');
          tabs.forEach(function (t) { t.setAttribute('aria-selected', String(t === tab)); });
          document.querySelectorAll('[data-panel]').forEach(function (p) {
            p.hidden = p.getAttribute('data-panel') !== which;
          });
          document.querySelectorAll('[data-caption]').forEach(function (c) {
            c.hidden = c.getAttribute('data-caption') !== which;
          });
        });
      });

      // Presenter: keep the screen awake while the QR is showing
      if (!visitor && 'wakeLock' in navigator) {
        var request = function () {
          navigator.wakeLock.request('screen').catch(function () {});
        };
        request();
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'visible') request();
        });
      }

      // Count contact saves in Analytics
      var save = document.querySelector('[data-save-contact]');
      if (save) {
        save.addEventListener('click', function () {
          if (typeof gtag === 'function') gtag('event', 'save_contact');
        });
      }

      // Count resume downloads in Analytics
      var resume = document.querySelector('[data-resume]');
      if (resume) {
        resume.addEventListener('click', function () {
          if (typeof gtag === 'function') gtag('event', 'download_resume');
        });
      }
    })();
  </script>
</body>
</html>

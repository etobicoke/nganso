---
// Reading layout for /writing/* posts.
// Astro 1.x markdown routing: a src/pages/writing/*.md file with
// `layout: ../../layouts/WritingLayout.astro` in its frontmatter renders here,
// with the compiled markdown injected into <slot />. Frontmatter arrives on
// Astro.props.frontmatter (title, description, dateLabel, etc.).
// Mirrors the homepage's design tokens so posts feel part of the same site.
const { frontmatter } = Astro.props;
const {
  title = "Writing",
  description = "Notes from Gustave Nganso on shipping AI in production.",
  dateLabel = "",
} = frontmatter ?? {};
import OlotalkSearch from "../components/OlotalkSearch.astro";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Analytics (gtag) — inlined verbatim so Astro leaves it untouched -->
  <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-1KVEFPH9TZ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1KVEFPH9TZ');
  </script>

  <title>{title} · Gustave Nganso</title>
  <meta name="description" content={description} />

  <!-- Fonts: same families as the homepage -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style is:global>
    /* ---------- Design tokens (shared with the homepage) ---------- */
    :root {
      --bg: #ffffff;
      --ink: #101418;
      --gray: #5b6470;
      --hairline: #e6e8eb;
      --accent: #2547f4;

      --sans: "Instrument Sans", system-ui, -apple-system, sans-serif;
      --mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;

      --measure: 720px;
      --pad: 24px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 18px;
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    a { color: inherit; }
    img { max-width: 100%; display: block; }

    a:focus-visible,
    summary:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: 2px;
    }

    .wrap {
      width: 100%;
      max-width: var(--measure);
      margin: 0 auto;
      padding-left: var(--pad);
      padding-right: var(--pad);
    }

    /* ---------- Sticky nav ---------- */
    .nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255, 255, 255, 0.72);
      -webkit-backdrop-filter: saturate(180%) blur(14px);
      backdrop-filter: saturate(180%) blur(14px);
      border-bottom: 1px solid var(--hairline);
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      height: 64px;
    }
    .nav-name {
      font-weight: 600;
      letter-spacing: -0.02em;
      font-size: 16px;
      text-decoration: none;
      white-space: nowrap;
    }
    .nav-back {
      font-family: var(--mono);
      font-size: 12.5px;
      letter-spacing: 0.02em;
      color: var(--gray);
      text-decoration: none;
      transition: color 0.18s ease;
    }
    .nav-back:hover { color: var(--accent); }

    /* ---------- Article header ---------- */
    .post-head {
      padding-top: 72px;
      padding-bottom: 40px;
      border-bottom: 1px solid var(--hairline);
    }
    .post-meta {
      font-family: var(--mono);
      font-size: 12.5px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--gray);
      margin: 0 0 22px;
    }
    .post-title {
      margin: 0;
      font-weight: 700;
      font-size: clamp(32px, 5.4vw, 52px);
      line-height: 1.06;
      letter-spacing: -0.03em;
    }
    .post-standfirst {
      margin: 26px 0 0;
      font-size: clamp(18px, 2.2vw, 21px);
      line-height: 1.55;
      color: var(--gray);
      max-width: 40em;
    }

    /* ---------- Prose (rendered markdown) ---------- */
    .prose {
      padding-top: 40px;
      padding-bottom: 88px;
    }
    .prose > * + * { margin-top: 1.35em; }
    .prose h2 {
      margin: 2em 0 0.6em;
      font-size: clamp(24px, 3.4vw, 30px);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }
    .prose h3 {
      margin: 1.8em 0 0.5em;
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .prose p { margin: 0; }
    .prose a {
      color: var(--accent);
      text-decoration: none;
      border-bottom: 1px solid rgba(37, 71, 244, 0.35);
      transition: border-color 0.18s ease;
    }
    .prose a:hover { border-color: var(--accent); }
    .prose strong { font-weight: 600; color: var(--ink); }
    .prose ul, .prose ol { margin: 0; padding-left: 1.3em; }
    .prose li { margin-top: 0.5em; }
    .prose blockquote {
      margin: 1.6em 0;
      padding: 4px 0 4px 22px;
      border-left: 3px solid var(--accent);
      color: var(--gray);
      font-size: 1.02em;
    }
    .prose blockquote p { margin: 0; }
    .prose hr {
      margin: 2.6em 0;
      border: 0;
      border-top: 1px solid var(--hairline);
    }
    .prose code {
      font-family: var(--mono);
      font-size: 0.86em;
      background: #f4f5f7;
      padding: 0.15em 0.4em;
      border-radius: 4px;
    }
    .prose pre {
      overflow-x: auto;
      padding: 18px 20px;
      border: 1px solid var(--hairline);
      border-radius: 8px;
      background: #fbfbfc;
      font-size: 13.5px;
      line-height: 1.6;
    }
    .prose pre code {
      background: none;
      padding: 0;
      font-size: inherit;
    }

    /* ---------- Post footer ---------- */
    .post-foot {
      padding-top: 32px;
      padding-bottom: 96px;
      border-top: 1px solid var(--hairline);
      font-family: var(--mono);
      font-size: 12.5px;
      letter-spacing: 0.02em;
      color: var(--gray);
      display: flex;
      flex-wrap: wrap;
      gap: 22px;
    }
    .post-foot a { color: var(--ink); text-decoration: none; }
    .post-foot a:hover { color: var(--accent); }
  </style>
</head>
<body>

  <header class="nav">
    <div class="wrap nav-inner">
      <a class="nav-name" href="/">Gustave Nganso</a>
      <a class="nav-back" href="/writing">← All writing</a>
    </div>
  </header>

  <main>
    <header class="wrap post-head">
      {dateLabel && <p class="post-meta">{dateLabel}</p>}
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-standfirst">{description}</p>}
    </header>

    <article class="wrap prose">
      <slot />
    </article>

    <footer class="wrap post-foot">
      <a href="/writing">← All writing</a>
      <a href="/">Home</a>
      <a href="/#contact">Get in touch</a>
    </footer>
  </main>

<OlotalkSearch />
</body>
</html>
